<Window x:Class="SummerInstaller.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Echo VR Classic Lobbies" Width="600" Height="1000" MinWidth="560" MinHeight="940"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanMinimize"
        AllowsTransparency="True" Background="Transparent" Icon="Resources/icon.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="0" CornerRadius="0" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="18" BorderBrush="#26FFFFFF" BorderThickness="1" ClipToBounds="True">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0.4,1">
                <GradientStop Color="{StaticResource BgTop}" Offset="0"/>
                <GradientStop Color="{StaticResource BgBottom}" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>
        <Grid>
            <!-- Background glow blobs. -->
            <Canvas IsHitTestVisible="False" ClipToBounds="True">
                <Ellipse Width="420" Height="420" Canvas.Left="-140" Canvas.Top="-170" Opacity="0.35">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="{StaticResource AccentBlue}" Offset="0"/>
                            <GradientStop Color="#003FD0FF" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="460" Height="460" Canvas.Left="300" Canvas.Top="420" Opacity="0.28">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="{StaticResource AccentOrange}" Offset="0"/>
                            <GradientStop Color="#00FF8A3D" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Canvas>

            <Grid Margin="36,0,36,30">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Caption bar -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,-24,0">
                    <Button Style="{StaticResource CaptionButton}" Click="Minimize_Click" ToolTip="Minimize" AutomationProperties.Name="Minimize"><TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
                    <Button Style="{StaticResource CaptionButton}" Click="Close_Click" ToolTip="Close" AutomationProperties.Name="Close"><TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/></Button>
                </StackPanel>

                <!-- Header: logo beside the titles -->
                <Grid Grid.Row="1" Margin="0,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Width="80" Height="80" VerticalAlignment="Center">
                        <Ellipse Width="70" Height="70" StrokeThickness="8" Opacity="0.55">
                            <Ellipse.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="{StaticResource AccentBlue}" Offset="0"/>
                                    <GradientStop Color="{StaticResource AccentOrange}" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Stroke>
                            <Ellipse.Effect><BlurEffect Radius="12"/></Ellipse.Effect>
                        </Ellipse>
                        <Ellipse x:Name="LogoRing" Width="70" Height="70" StrokeThickness="8" RenderTransformOrigin="0.5,0.5">
                            <Ellipse.Stroke>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="{StaticResource AccentBlue}" Offset="0"/>
                                    <GradientStop Color="{StaticResource AccentOrange}" Offset="1"/>
                                </LinearGradientBrush>
                            </Ellipse.Stroke>
                            <Ellipse.RenderTransform><RotateTransform x:Name="LogoRotation"/></Ellipse.RenderTransform>
                        </Ellipse>
                        <Ellipse Width="18" Height="18" Fill="#FFD678"/>
                    </Grid>
                    <StackPanel Grid.Column="1" Margin="20,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TitleText" Text="ECHO VR" FontSize="12.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource Blue}" TextOptions.TextFormattingMode="Ideal"/>
                        <TextBlock x:Name="SubtitleText" Text="Classic Lobbies" FontSize="32" FontWeight="Bold"
                                   FontFamily="Segoe UI Variable Display, Segoe UI" TextOptions.TextFormattingMode="Ideal"/>
                        <TextBlock x:Name="TaglineText" Text="The 2019 summer build, running on community servers."
                                   FontSize="13.5" Foreground="{StaticResource TextDim}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>

                <!-- Views -->
                <Grid Grid.Row="2" Margin="0,22,0,0">

                    <!-- Setup view -->
                    <Grid x:Name="SetupView">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" CornerRadius="16" Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="22,20">
                            <StackPanel>
                                <!-- Build -->
                                <TextBlock Text="Game version" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextDim}"/>
                                <UniformGrid Columns="2" Margin="0,8,0,18">
                                    <RadioButton x:Name="SummerBuildOption" GroupName="Build" Style="{StaticResource BuildOption}" Margin="0,0,6,6"
                                                 Content="Summer 2019" Tag="summer" Checked="BuildOption_Checked" AutomationProperties.Name="Summer 2019 build"/>
                                    <RadioButton x:Name="HalloweenBuildOption" GroupName="Build" Style="{StaticResource BuildOption}" Margin="6,0,0,6"
                                                 Content="Halloween 2018" Tag="halloween" Checked="BuildOption_Checked" AutomationProperties.Name="Halloween 2018 build"/>
                                    <RadioButton x:Name="WinterBuildOption" GroupName="Build" Style="{StaticResource BuildOption}" Margin="0,6,6,0"
                                                 Content="Christmas 2018" Tag="winter" Checked="BuildOption_Checked" AutomationProperties.Name="Christmas 2018 build"/>
                                    <RadioButton x:Name="ChristmasBuildOption" GroupName="Build" Style="{StaticResource BuildOption}" Margin="6,6,0,0"
                                                 Content="Christmas 2017" Tag="christmas" Checked="BuildOption_Checked" AutomationProperties.Name="Christmas 2017 build"/>
                                </UniformGrid>

                                <TextBlock Text="Install location" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextDim}"/>
                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="FolderBox" TextChanged="FolderBox_TextChanged"/>
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="44" Margin="10,0,0,0" Padding="16,0" Click="Browse_Click" AutomationProperties.Name="Browse">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center"/>
                                            <TextBlock Text="Browse" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock x:Name="SpaceText" Margin="2,8,0,0" FontSize="12.5" Foreground="{StaticResource TextFaint}"/>

                                <!-- Account -->
                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Display name" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextDim}"/>
                                        <TextBox x:Name="NameBox" Margin="0,8,0,0" MaxLength="20"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Password" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextDim}"/>
                                        <Grid Margin="0,8,0,0">
                                            <PasswordBox x:Name="PasswordInput" MaxLength="64"/>
                                            <TextBox x:Name="PasswordVisible" MaxLength="64" Padding="12,0,44,0" Visibility="Collapsed"/>
                                            <Button x:Name="ShowPasswordButton" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Margin="0,0,4,0"
                                                    Click="ShowPassword_Click" ToolTip="Show password" AutomationProperties.Name="Show password">
                                                <TextBlock x:Name="ShowPasswordGlyph" Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Margin="2,8,0,0" FontSize="12.5" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap"
                                           Text="Your name in the lobby (up to 20 characters). The first login locks your account to this password, so keep it; don't reuse a real one."/>

                                <!-- Server config -->
                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Server" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextDim}"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <Border x:Name="ConfigBadge" CornerRadius="6" Padding="8,2" Background="#223FD0FF" VerticalAlignment="Center">
                                                <TextBlock x:Name="ConfigBadgeText" Text="Default" FontSize="11.5" FontWeight="SemiBold" Foreground="{StaticResource Blue}"/>
                                            </Border>
                                            <TextBlock x:Name="ConfigServerText" Margin="10,0,0,0" FontSize="13.5" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Height="40" Padding="16,0" Click="ChangeConfig_Click" AutomationProperties.Name="Change server config">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                                            <TextBlock Text="Change…" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Game server requests (the region picker only when the server hosts this version somewhere) -->
                                <Grid x:Name="GameServerRow" Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Game server" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextDim}"/>
                                        <TextBlock Margin="0,4,0,0" FontSize="12.5" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap"
                                                   Text="Have the server start one for you in a region, then press Play."/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button x:Name="RegionAction" Style="{StaticResource SecondaryButton}" Height="40" Padding="14,0" Margin="0,0,8,0" Click="Region_Click" Visibility="Collapsed"
                                                AutomationProperties.Name="Game server region" ToolTip="The region to request a game server in. Click to change.">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE909;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="RegionText" Text="Region" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="RequestServerAction" Style="{StaticResource SecondaryButton}" Height="40" Padding="16,0" Click="RequestServer_Click"
                                                AutomationProperties.Name="Request server" ToolTip="Ask the server to start a game server of this version for you, in the region shown (if it allows it)">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="13" VerticalAlignment="Center"/>
                                                <TextBlock Text="Request" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Publisher lock -->
                                <Grid Margin="0,18,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock Text="Publisher lock" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource TextDim}"/>
                                        <TextBlock x:Name="PublisherLockText" Margin="0,4,0,0" FontSize="12.5" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap"
                                                   Text="Tells the server which game version you play. Follows the game version."/>
                                    </StackPanel>
                                    <UniformGrid Grid.Column="1" Columns="2" VerticalAlignment="Center">
                                        <RadioButton x:Name="SummerLockOption" GroupName="PublisherLock" Style="{StaticResource BuildOption}" Height="36" Width="110" FontSize="13" Margin="0,0,4,4"
                                                     Content="Summer" Tag="rad15_summer" Checked="PublisherLockOption_Checked" ToolTip="rad15_summer" AutomationProperties.Name="Summer publisher lock"/>
                                        <RadioButton x:Name="HalloweenLockOption" GroupName="PublisherLock" Style="{StaticResource BuildOption}" Height="36" Width="110" FontSize="13" Margin="4,0,0,4"
                                                     Content="Halloween" Tag="rad15_halloween" Checked="PublisherLockOption_Checked" ToolTip="rad15_halloween" AutomationProperties.Name="Halloween publisher lock"/>
                                        <RadioButton x:Name="WinterLockOption" GroupName="PublisherLock" Style="{StaticResource BuildOption}" Height="36" Width="110" FontSize="13" Margin="0,4,4,0"
                                                     Content="Xmas 2018" Tag="rad15_winter" Checked="PublisherLockOption_Checked" ToolTip="rad15_winter" AutomationProperties.Name="Christmas 2018 publisher lock"/>
                                        <RadioButton x:Name="ChristmasLockOption" GroupName="PublisherLock" Style="{StaticResource BuildOption}" Height="36" Width="110" FontSize="13" Margin="4,4,0,0"
                                                     Content="Xmas 2017" Tag="rad15_live" Checked="PublisherLockOption_Checked" ToolTip="rad15_live" AutomationProperties.Name="Christmas 2017 publisher lock"/>
                                    </UniformGrid>
                                </Grid>

                                <CheckBox x:Name="ShortcutCheck" Content="Create a desktop shortcut" IsChecked="True" Margin="0,18,0,0"/>
                            </StackPanel>
                        </Border>

                        <!-- Error / status banner -->
                        <Border x:Name="Banner" Grid.Row="1" VerticalAlignment="Top" Margin="0,14,0,0" CornerRadius="12" Padding="16,12"
                                Background="#26FF6B6B" BorderBrush="#66FF6B6B" BorderThickness="1" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="BannerIcon" Text="&#xE783;" FontFamily="Segoe MDL2 Assets" FontSize="16" Foreground="{StaticResource Danger}" VerticalAlignment="Top" Margin="0,1,12,0"/>
                                <TextBlock x:Name="BannerText" TextWrapping="Wrap" FontSize="13.5" MaxWidth="440"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="SecondaryAction" Style="{StaticResource SecondaryButton}" Content="Reinstall" Margin="0,0,12,0" Click="SecondaryAction_Click" Visibility="Collapsed"/>
                            <Button x:Name="PrimaryAction" Style="{StaticResource PrimaryButton}" Content="Install" MinWidth="170" Click="PrimaryAction_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Config editor view -->
                    <Grid x:Name="ConfigView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border CornerRadius="16" Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="22,20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="Server config" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="1" Margin="0,6,0,14" FontSize="13" Foreground="{StaticResource TextDim}" TextWrapping="Wrap"
                                           Text="Paste the config.json for the server you want to play on, or load it from a file. Your display name and password are added to it automatically."/>
                                <TextBox x:Name="ConfigEditor" Grid.Row="2" Height="Auto" MinHeight="140" AcceptsReturn="True" AcceptsTab="True"
                                         VerticalContentAlignment="Top" Padding="10,10" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                                         TextWrapping="Wrap" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" VerticalAlignment="Stretch"
                                         TextChanged="ConfigEditor_TextChanged"/>
                                <Grid Grid.Row="3" Margin="0,12,0,0">
                                    <TextBlock x:Name="ConfigStatus" FontSize="12.5" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap" Margin="0,0,200,0" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource SecondaryButton}" Height="36" Padding="14,0" FontSize="13" Content="Load file…" Click="LoadConfigFile_Click"/>
                                        <Button Style="{StaticResource SecondaryButton}" Height="36" Padding="14,0" FontSize="13" Margin="8,0,0,0" Content="Reset" Click="ResetConfig_Click" ToolTip="Go back to the default config"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                            <Button Style="{StaticResource SecondaryButton}" Content="Cancel" MinWidth="110" Margin="0,0,12,0" Click="CancelConfig_Click"/>
                            <Button x:Name="UseConfigButton" Style="{StaticResource PrimaryButton}" Content="Use this config" MinWidth="170" Click="UseConfig_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Progress view -->
                    <Grid x:Name="ProgressView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border CornerRadius="16" Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="22,22">
                            <StackPanel>
                                <!-- Steps -->
                                <UniformGrid x:Name="Steps" Columns="4" Margin="0,0,0,22"/>

                                <Grid>
                                    <TextBlock x:Name="StageText" Text="Downloading" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="PercentText" Text="0%" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{StaticResource Blue}"/>
                                </Grid>

                                <!-- Progress bar -->
                                <Border x:Name="Track" Height="12" CornerRadius="6" Background="#1AFFFFFF" Margin="0,14,0,0" ClipToBounds="True" SizeChanged="Track_SizeChanged">
                                    <Grid>
                                        <Border x:Name="Fill" HorizontalAlignment="Left" Width="0" CornerRadius="6" Background="{StaticResource ProgressGradient}"/>
                                        <Border x:Name="Shimmer" HorizontalAlignment="Left" Width="140" CornerRadius="6" Visibility="Collapsed"
                                                Background="{StaticResource ProgressGradient}">
                                            <Border.RenderTransform><TranslateTransform x:Name="ShimmerOffset"/></Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                </Border>

                                <TextBlock x:Name="DetailText" Margin="0,12,0,0" FontSize="13" Foreground="{StaticResource TextDim}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                        </Border>
                        <TextBlock x:Name="PauseHint" Grid.Row="1" Margin="4,16,0,0" FontSize="12.5" Foreground="{StaticResource TextFaint}" TextWrapping="Wrap"
                                   Text="You can pause at any time; the download resumes where it stopped."/>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="PauseButton" Style="{StaticResource SecondaryButton}" Content="Pause" MinWidth="130" Click="Pause_Click"/>
                        </StackPanel>
                    </Grid>

                    <!-- Done view -->
                    <Grid x:Name="DoneView" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border CornerRadius="16" Background="{StaticResource Card}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1" Padding="22,22">
                            <StackPanel Orientation="Horizontal">
                                <Grid Width="52" Height="52" VerticalAlignment="Top">
                                    <Ellipse Fill="{StaticResource AccentGradient}"/>
                                    <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="22" Foreground="#06101F" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel Margin="18,0,0,0" MaxWidth="380">
                                    <TextBlock Text="Ready to play" FontSize="22" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="DonePath" Margin="0,4,0,0" FontSize="13" Foreground="{StaticResource TextDim}" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="DoneHint" Margin="0,14,0,0" FontSize="13" Foreground="{StaticResource TextDim}" TextWrapping="Wrap"
                                               Text="Start the Oculus app and connect your headset before pressing Play. In the game, press Play on the menu to join the summer lobby."/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource SecondaryButton}" Content="Open folder" Margin="0,0,12,0" Click="OpenFolder_Click"/>
                            <Button Style="{StaticResource PrimaryButton}" Content="Play" MinWidth="150" Click="Play_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
