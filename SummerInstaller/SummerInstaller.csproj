<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- .NET Framework 4.8 ships with Windows 10/11, so the installer is a single small exe with no runtime to install. -->
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>EchoClassicLobbies</AssemblyName>
    <RootNamespace>SummerInstaller</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\icon.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Echo VR Classic Lobbies Installer</Product>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- WebView2 (the Edge runtime in Windows 10/11) loads Proton Drive's page, which decrypts shared files. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2592.51" />
  </ItemGroup>

  <!-- The WebView2 DLLs go inside the exe (loaded in App.xaml.cs / ProtonDownload.cs), so it's still a single file. -->
  <PropertyGroup>
    <WebView2PackageFolder>$(NuGetPackageRoot)microsoft.web.webview2\1.0.2592.51\</WebView2PackageFolder>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(WebView2PackageFolder)lib\net462\Microsoft.Web.WebView2.Core.dll" LogicalName="webview2.Microsoft.Web.WebView2.Core.dll" Visible="false" />
    <EmbeddedResource Include="$(WebView2PackageFolder)lib\net462\Microsoft.Web.WebView2.Wpf.dll" LogicalName="webview2.Microsoft.Web.WebView2.Wpf.dll" Visible="false" />
    <EmbeddedResource Include="$(WebView2PackageFolder)runtimes\win-x64\native\WebView2Loader.dll" LogicalName="webview2.win-x64.WebView2Loader.dll" Visible="false" />
    <EmbeddedResource Include="$(WebView2PackageFolder)runtimes\win-x86\native\WebView2Loader.dll" LogicalName="webview2.win-x86.WebView2Loader.dll" Visible="false" />
    <EmbeddedResource Include="$(WebView2PackageFolder)runtimes\win-arm64\native\WebView2Loader.dll" LogicalName="webview2.win-arm64.WebView2Loader.dll" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Xml" />
    <Reference Include="System.Xml.Linq" />
  </ItemGroup>

  <ItemGroup>
    <!-- installer.json: where to download the build from. config.json: written to <install>\_local\config.json. -->
    <EmbeddedResource Include="Resources\installer.json" LogicalName="installer.json" />
    <EmbeddedResource Include="Resources\config.json" LogicalName="config.json" />
    <Resource Include="Resources\icon.ico" />
  </ItemGroup>

</Project>
